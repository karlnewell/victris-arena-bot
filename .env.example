# Copy to .env (git-ignored). Loaded by `npm start` and by `uv run --env-file ../.env`.

# Required: the bot's secret token, shown once when the bot was registered.
ARENA_TOKEN=

# Every strategy change should queue as a new version (v3 is the current scripted bot).
ARENA_VERSION=v3

# Optional: stop after this many matches (unset = keep playing).
#ARENA_MATCHES=10
# Optional: queue for a specific ladder.
#ARENA_LADDER=
# Optional: defaults to wss://victrisarena.com/bot
#ARENA_URL=
# Optional: only if this host reaches the internet through a proxy.
#HTTPS_PROXY=
# Optional (ml/net_bot.py): model path, default ml/models/current.pt
#ARENA_MODEL=
